EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Google 로그인 — Firebase 콘솔에서 Google Provider 활성화 시 자동 발급되는 Web client ID.
# @react-native-google-signin/google-signin의 GoogleSignin.configure({ webClientId })에 사용된다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Google 로그인(iOS) — Google Cloud Console에서 발급받는 iOS OAuth client.
# GoogleService-Info.plist를 쓰지 않는 프로젝트라 두 값을 직접 채워야 한다:
# - EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID: iOS client ID 그대로. GoogleSignin.configure({ iosClientId })에 쓰인다.
# - EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME: 같은 iOS client ID를 "com.googleusercontent.apps.<번호>" 형태로
#   뒤집은 값(Reversed client ID). app.config.js가 prebuild 시점에 iOS Info.plist URL scheme으로 심는다.
#   iOS 빌드를 시작하기 전까지는 비워둬도 된다(비어있으면 app.config.js가 google-signin config plugin
#   자체를 건너뛴다 — Android 네이티브 로그인 동작에는 영향 없음).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_client_ios_key_here
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=your_google_scheme_ios_key_here

# Google Maps SDK — react-native-maps용. EXPO_PUBLIC_ 접두사가 없는 이유: 클라이언트 JS 번들이 아니라 app.config.js가 네이티브 빌드(prebuild) 시점에만 읽는 값이라서다.
# Google Cloud Console에서 "Maps SDK for Android"/"Maps SDK for iOS"만 활성화하고,
# API 키를 패키지명(com.bterritory.app) + SHA-1으로 제한해서 발급받는다.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_key_here
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_key_here
