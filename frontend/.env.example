EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Google 로그인 — Firebase 콘솔에서 Google Provider 활성화 시 자동 발급되는 Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Google Maps SDK — react-native-maps용. EXPO_PUBLIC_ 접두사가 없는 이유: 클라이언트 JS 번들이 아니라 app.config.js가 네이티브 빌드(prebuild) 시점에만 읽는 값이라서다.
# Google Cloud Console에서 "Maps SDK for Android"/"Maps SDK for iOS"만 활성화하고,
# API 키를 패키지명(com.bterritory.app) + SHA-1으로 제한해서 발급받는다.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_key_here
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_key_here
