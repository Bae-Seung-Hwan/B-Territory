# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=b_territory

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# 한국관광공사 API
TOUR_API_KEY=your-tour-api-key

# AWS S3 (미션 사진 업로드)
# 자격증명은 아래 키 또는 EC2 인스턴스 IAM 역할(권장)에서 온다.
AWS_REGION=ap-northeast-2
S3_BUCKET=your-s3-bucket
# AWS_ACCESS_KEY_ID=your-access-key        # IAM 역할 사용 시 생략
# AWS_SECRET_ACCESS_KEY=your-secret-key    # IAM 역할 사용 시 생략
# S3_PUBLIC_BASE_URL=https://cdn.example.com  # CDN/커스텀 도메인 있을 때만

# 배포(docker-compose.prod.yml) 전용 — Let's Encrypt 인증서 알림 이메일 (선택)
# 미설정 시 도메인 기반 기본값이 쓰인다. 자세한 내용은 docs/deployment.md 참고
# ACME_EMAIL=your-email@example.com
