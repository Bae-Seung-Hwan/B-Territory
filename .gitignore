# 의존성
node_modules/

# 빌드 결과물
dist/
*.tsbuildinfo
# 법적 문서 정적 페이지 — scripts/build-legal-pages.mjs가 만들고 CI가 배포한다.
# 커밋하면 조항과 생성물이 갈라질 수 있어(둘 중 하나만 고친 커밋) 산출물은 두지 않는다.
# 앵커(/)를 붙여 **루트의** web/만 무시한다 — 앵커가 없으면 frontend/web/ 같은 하위
# 디렉터리까지 함께 무시돼 그 안의 소스가 조용히 커밋에서 빠진다.
/web/
/.legal-build/

# 환경변수 (절대 커밋 금지!)
.env
.env.local
.env.production
# Google Play 업로드용 서비스 계정 키 (eas.json의 serviceAccountKeyPath) — 이 키 하나로
# 스토어에 앱을 올릴 수 있으므로 절대 커밋하지 않는다.
frontend/google-play-service-account.json

# 로그
*.log
npm-debug.log*

# 에디터
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# GeoJSON 중간 산출물 (busan_sig.json으로 재생성 가능한 백업본)
frontend/assets/geo/busan_sig.epsg5179.json
frontend/assets/geo/busan_sig_simplified.json

# API 응답 덤프 (확인용 임시 파일)
frontend/docs/busan_spots.json
